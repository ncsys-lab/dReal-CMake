(set-logic QF_NRA_ODE)
(declare-fun x () Real [0.000000, 100.000000])
(declare-fun x_0_0 () Real [0.000000, 100.000000])
(declare-fun x_0_t () Real [0.000000, 100.000000])
(declare-fun time_0 () Real [1.000000, 1.000000])
(declare-fun mode () Real [1.000000, 1.000000])
(define-ode flow_1 ((= d/dt[x] (* -0.5 x))))
(assert (and
  (= mode 1)
  (= x_0_0 100)
  (= [x_0_t] (integral 0. time_0 [x_0_0] flow_1))
  (>= x_0_t 0)
  (<= x_0_t 61)
))
(check-sat)
(exit)
