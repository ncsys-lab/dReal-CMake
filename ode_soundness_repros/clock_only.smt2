(set-logic QF_NRA_ODE)
(declare-fun tau () Real [0.0, 10.0])
(declare-fun tau_0 () Real [0.0, 10.0])
(declare-fun tau_t () Real [0.0, 10.0])
(declare-fun time () Real [0.0, 1.0])
(define-ode flow_1 ((= d/dt[tau] 1)))
(assert (and (= tau_0 0.0) (= [tau_t] (integral 0. time [tau_0] flow_1)) (>= tau_t 1.0) (<= tau_t 1.0)))
(check-sat)
(exit)
