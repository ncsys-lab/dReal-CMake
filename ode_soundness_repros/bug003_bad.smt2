(set-logic QF_NRA_ODE)
(declare-fun x () Real [0.000000, 100.000000])
(declare-fun y () Real [0.000000, 50.000000])
(declare-fun x_0 () Real [0.000000, 100.000000])
(declare-fun x_t () Real [0.000000, 100.000000])
(declare-fun y_0 () Real [0.000000, 50.000000])
(declare-fun y_t () Real [0.000000, 50.000000])
(declare-fun time () Real [1.000000, 1.000000])
(declare-fun mode () Real [1.000000, 1.000000])
(define-ode flow_1 ((= d/dt[x] y) (= d/dt[y] 0)))
(assert (and
  (= mode 1)
  (= x_0 20)
  (= y_0 30)
  (= [x_t y_t] (integral 0. time [x_0 y_0] flow_1))
  (>= x_t 49)
))
(check-sat)
(exit)
