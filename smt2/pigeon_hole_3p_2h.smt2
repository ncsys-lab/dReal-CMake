(set-option :precision 0.001)
(declare-const p0 Real)
(declare-const p1 Real)
(declare-const p2 Real)
(assert (or (>= (+ p1 (* -1 p0)) 1) (>= (+ p0 (* -1 p1)) 1)))
(assert (or (>= (+ p2 (* -1 p0)) 1) (>= (+ p0 (* -1 p2)) 1)))
(assert (or (>= (+ p2 (* -1 p1)) 1) (>= (+ p1 (* -1 p2)) 1)))
(assert (and (>= p0 0) (< p0 2)))
(assert (and (>= p1 0) (< p1 2)))
(assert (and (>= p2 0) (< p2 2)))
(check-sat)(get-model)(exit)