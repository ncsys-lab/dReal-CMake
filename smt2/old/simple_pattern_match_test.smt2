(set-logic QF_NRAT)
(declare-const x1 Real [0.2, 1.2])
(declare-const y1 Real)
(declare-const x2 Real [0.5, 1.1])
(declare-const y2 Real)
(declare-const x3 Real [0.2, 1.2])
(declare-const y3 Real)
(assert (or
    (and (= y1 (sin x1)) (= y1 (atan x1)))
    (and (= y2 (sin x2)) (= y2 (atan x2)))
    (and (= y3 (sin x3)) (= y3 (atan x3)))
))
(check-sat)
(get-model)
(exit)
