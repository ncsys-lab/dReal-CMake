(set-logic QF_NRA)
(declare-fun x0 () Real)
(declare-fun y0 () Real)
(declare-fun x1 () Real)
(declare-fun y1 () Real)
(declare-fun x2 () Real)
(declare-fun y2 () Real)

(assert (and (<= x0 7.5) (<= 2.5 x0)))
(assert (and (<= y0 8.75) (<= 1.25 y0)))
(assert (and (<= x1 7.5) (<= 2.5 x1)))
(assert (and (<= y1 8.75) (<= 1.25 y1)))
(assert (and (<= x2 7.5) (<= 2.5 x2)))
(assert (and (<= y2 8.75) (<= 1.25 y2)))

(assert (and
(or (<= 5.0 (- x0 x1)) (<= 5.0 (- x1 x0)) (<= 2.5 (- y0 y1)) (<= 2.5 (- y1 y0)))
(or (<= 5.0 (- x0 x2)) (<= 5.0 (- x2 x0)) (<= 2.5 (- y0 y2)) (<= 2.5 (- y2 y0)))
(or (<= 5.0 (- x1 x2)) (<= 5.0 (- x2 x1)) (<= 2.5 (- y1 y2)) (<= 2.5 (- y2 y1)))
))
(check-sat)
(exit)
